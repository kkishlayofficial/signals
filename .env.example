# ============================================
# TRADING SIGNAL AUTOMATION — CONFIGURATION
# ============================================
# Copy this file to `.env` and fill in your credentials.
# NEVER commit `.env` to git. It's in .gitignore.

# ---- Telegram API (from https://my.telegram.org) ----
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+919999999999

# Comma-separated list of Telegram channel usernames or IDs to monitor.
# Example: "@signalchannel1,@signalchannel2" or "-1001234567890"
TELEGRAM_SIGNAL_CHANNELS=@your_signal_channel

# Your own Telegram user ID (where trade confirmations will be sent).
# Get it from @userinfobot on Telegram.
TELEGRAM_NOTIFY_USER_ID=123456789

# ---- Angel One SmartAPI ----
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=A123456
ANGEL_PASSWORD=your_mpin_or_password
ANGEL_TOTP_SECRET=JBSWY3DPEHPK3PXP

# ---- Trading Mode ----
# "paper" = simulated trades, no real money
# "live" = real orders placed via Angel One
TRADING_MODE=paper

# ---- Risk Management ----
# Default quantity (lots) per trade.
# For CRUDEOIL options, 1 lot = 100 units.
DEFAULT_QUANTITY=1

# Maximum open positions at once
MAX_OPEN_POSITIONS=3

# Max capital allocated per trade (₹). Set to 0 to disable.
MAX_CAPITAL_PER_TRADE=10000

# ---- Price Polling ----
# How often (seconds) to check LTP for pending/active positions.
PRICE_POLL_INTERVAL=5

# ---- Stoploss Protection ----
# Place a real STOPLOSS order at the exchange as soon as a live entry fills,
# so the position stays protected if this script crashes, the machine sleeps,
# or price gaps between two polls. Only turn this off if you intend to watch
# positions manually. (Live mode only; paper mode simulates the stop.)
USE_EXCHANGE_STOPLOSS=true

# A stop-LIMIT order needs its limit price past the trigger or it may never
# fill in a fast move. This is that gap, as a % of the trigger price.
SL_LIMIT_BUFFER_PCT=0.5

# Seconds to wait for a placed order to appear filled in the order book
# before falling back to the last traded price for P&L purposes.
ORDER_FILL_TIMEOUT=20

# ---- Housekeeping ----
# A PENDING signal whose trigger never arrived is cancelled after this many
# hours. Without it, untriggered signals pile up and permanently consume
# MAX_OPEN_POSITIONS, silently blocking every later signal.
PENDING_TTL_HOURS=12

# ---- Dashboard API ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=change_me_to_a_random_secret
# Bind address for the embedded FastAPI server. Keep this on localhost unless
# you understand the exposure — there is no network-level auth beyond the
# bearer token above.
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8000
# Enables scripts/inject_signal.py and other non-production helpers. Leave
# false outside of local development.
DEV_TOOLS=false
